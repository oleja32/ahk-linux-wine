"""Run .ahk scripts with the genuine AutoHotkey interpreter, bridged to Linux input."""
import fcntl, filecmp, glob, hashlib, os, re, shutil, subprocess, sys, tarfile, tempfile, time, urllib.request

HOME = os.environ.get("AHKB_HOME") or os.path.expanduser("~/.local/share/ahk-bridge")
RUN = os.environ.get("AHKB_RUN") or os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "ahk-bridge")
USAGE = """usage: ahk [--v1|--v2] [--default-v1] [--debug] script.ahk [args...]
       ahk --windows  list windows with the names #IfWinActive can match
       ahk --stop     close every running script and release the keyboard
       ahk --update   install the newest version        ahk --version
       ahk --no-update-check   never look for updates   (ahk --update-check: once a day again)
Emergency: hold Left Ctrl + Right Ctrl + Esc to release the keyboard and mouse."""


def die(msg):
    print(f"ahk: {msg}", file=sys.stderr)
    if not sys.stderr.isatty():  # started by double-click: nobody sees stderr
        try: subprocess.run(["notify-send", "-a", "ahk", "AutoHotkey", msg], timeout=5)
        except (OSError, subprocess.TimeoutExpired): pass
    sys.exit(1)


def wine_env():
    e = dict(os.environ)
    e["WINEPREFIX"] = os.path.join(HOME, "prefix")
    e.setdefault("WINEDEBUG", "-all")
    e["WINEDLLOVERRIDES"] = "version=n,b;winemenubuilder.exe=;" + e.get("WINEDLLOVERRIDES", "")
    return e


def win(path):
    return "Z:" + os.path.abspath(path).replace("/", "\\")


def make_prefix(e, path):
    """A new Wine folder at path; it appears only when complete. Without a display, so Wine shows no window."""
    new = path + ".new"
    shutil.rmtree(new, ignore_errors=True)
    q = dict(e, WINEPREFIX=new, WINEDLLOVERRIDES="mscoree=;mshtml=;winemenubuilder.exe=")
    for k in ("DISPLAY", "WAYLAND_DISPLAY"): q.pop(k, None)
    ok = subprocess.run(["wineboot", "-i"], env=q, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    subprocess.run(["wineserver", "-w"], env=q)
    if not ok or not os.path.exists(new + "/system.reg"):
        shutil.rmtree(new, ignore_errors=True)
        die("Wine could not create its folder; does `wine --version` work?")
    shrink_prefix(new)
    os.rename(new, path)


def shrink_prefix(path):
    """Wine fills a new folder with copies of its own programs (over 300 MB); replaces them with links to the originals.
    Only to files we cannot write: Wine writes through links when it updates a folder."""
    ours = {}
    roots = ("/usr", os.path.dirname(os.path.dirname(os.path.realpath(shutil.which("wine") or "/usr/bin/wine"))))
    dirs = {os.path.realpath(d) for r in roots for g in ("/lib*/wine/*-windows", "/lib*/*/wine/*-windows") for d in glob.glob(r + g)}
    for d in sorted(dirs):
        if os.access(d, os.W_OK): continue
        for f in os.scandir(d):
            if f.is_file(): ours.setdefault(f.stat().st_size, []).append(f.path)
    for d, _, files in os.walk(path + "/drive_c/windows"):
        for f in files:
            p = os.path.join(d, f)
            # the same name first; comctl32 has another one
            for o in () if os.path.islink(p) else sorted(ours.get(os.path.getsize(p), ()), key=lambda o: os.path.basename(o) != f):
                if filecmp.cmp(p, o, False) and not os.access(o, os.W_OK):
                    os.symlink(o, p + ".link")
                    os.replace(p + ".link", p)
                    break


def repair_prefix(e, path):
    """Wine's files have moved (another package, for example): replaces the dead links, keeps the registry and all else."""
    tmp = path + ".fresh"
    shutil.rmtree(tmp, ignore_errors=True)
    make_prefix(e, tmp)
    for d, _, files in os.walk(path + "/drive_c/windows"):
        for f in files:
            p = os.path.join(d, f)
            if not os.path.islink(p) or os.path.exists(p): continue
            n = os.path.join(tmp, os.path.relpath(p, path))
            if os.path.exists(n): shutil.copy2(n, p + ".link", follow_symlinks=False); os.replace(p + ".link", p)
            else: os.unlink(p)
    shutil.rmtree(tmp, ignore_errors=True)


def ensure_prefix(e):
    p = e["WINEPREFIX"]
    missing = lambda: not os.path.exists(p + "/system.reg")
    dead = lambda: any(not os.path.exists(f) for d in ("system32", "syswow64") for f in glob.iglob(f"{glob.escape(p)}/drive_c/windows/{d}/*") if os.path.islink(f))
    if not missing() and not dead(): return
    with open(p + ".lock", "w") as lock:  # two scripts may be started at once
        fcntl.flock(lock, fcntl.LOCK_EX)
        if missing():
            print("ahk: preparing Wine (first run only)...", file=sys.stderr)
            shutil.rmtree(p, ignore_errors=True)  # left unfinished by 0.2
            make_prefix(e, p)
        elif dead():
            print("ahk: Wine has moved, repairing its folder...", file=sys.stderr)
            repair_prefix(e, p)


def endpoint():
    try:
        with open(os.path.join(RUN, "endpoint")) as f:
            port, token, *proto = f.read().split()
    except (OSError, ValueError):
        return None
    # A held lock means the daemon that wrote the endpoint is alive.
    try:
        with open(os.path.join(RUN, "lock")) as l:
            fcntl.flock(l, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return None
    except BlockingIOError:
        return port, token, int(proto[0]) if proto else 1
    except OSError:
        return None


def ensure_daemon(debug):
    if ep := endpoint():
        if ep[2] != version()[1]:
            die("ahk-linux-wine was updated while scripts are running. Close them first: ahk --stop")
        return ep[:2]
    if not os.access("/dev/uinput", os.W_OK) or not any(os.access(p, os.R_OK) for p in glob.glob("/dev/input/event*")):
        die("no permission to use the keyboard and mouse devices; run ./setup.sh from the ahk-linux-wine folder")
    os.makedirs(RUN, mode=0o700, exist_ok=True)
    try:
        os.unlink(os.path.join(RUN, "endpoint"))
    except FileNotFoundError:
        pass
    log = open(os.path.join(RUN, "ahkd.log"), "w")
    cmd = [os.path.join(HOME, "bin", "ahkd"), *(["-v"] if debug else []), RUN]
    p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    for _ in range(100):
        if ep := endpoint():
            return ep[:2]
        if p.poll():
            break
        time.sleep(0.03)
    die(f"input daemon failed to start, see {log.name}")


def detect(script, e, default):
    raw = open(script, "rb").read()
    enc = "utf-16" if raw[:2] in (b"\xff\xfe", b"\xfe\xff") else "utf-8-sig"
    text = raw.decode(enc, "replace")
    # 1. #Requires, exactly as the official launcher honours it
    if m := re.search(r"^[ \t]*#Requires[ \t]+AutoHotkey[ \t]+(?:>=?[ \t]*|=[ \t]*)?v?([12])", text, re.I | re.M):
        return m[1]
    # 2. AutoHotkey's own syntax identifier, run by AutoHotkey itself (cached by content)
    cache = os.path.join(HOME, "cache", "2-" + hashlib.sha256(raw).hexdigest())
    if os.path.exists(cache):
        v = open(cache).read()
    else:
        os.makedirs(os.path.dirname(cache), exist_ok=True)
        q = {k: x for k, x in e.items() if not k.startswith("AHKB_")}
        def v2(*args):  # into a file: a pipe would stay open until Wine's background processes exit
            with tempfile.TemporaryFile() as o:
                c = subprocess.run(["wine", os.path.join(HOME, "v2", "AutoHotkey64.exe"), "/ErrorStdOut", *args], env=q, stdin=subprocess.DEVNULL, stdout=o, stderr=o, timeout=60)
                o.seek(0)
                return c.returncode, o.read()
        with tempfile.TemporaryDirectory() as t:
            src, out, warn = (os.path.join(t, n) for n in ("s.ahk", "out", "warn.ahk"))
            with open(src, "w", encoding="utf-8", newline="") as f:
                f.write(text)
            with open(warn, "w") as f:
                f.write("#Warn All, StdOut\n")  # as text: a warning window would wait for a click
            try:
                v2(win(os.path.join(HOME, "detect.ahk")), win(src), win(out))
                v = open(out).read().lstrip("\ufeff").strip() if os.path.exists(out) else "0"
                if v == "0":
                    # 3. Too short to tell: v1 if v2 refuses to load it, or takes its plain text ("Send Hello") for unset variables
                    code, said = v2("/include", win(warn), "/validate", win(script))
                    v = "1" if code == 2 or b"never be assigned a value" in said else "0"
            except subprocess.TimeoutExpired:
                return default
        with open(cache, "w") as f:
            f.write(v)
    if v in ("1", "2"):
        return v
    print(f"ahk: can't tell whether this is v1 or v2; using v{default} (override with --v1/--v2)", file=sys.stderr)
    return default


def list_windows():
    import socket, struct
    port, token = ensure_daemon(False)
    s = socket.create_connection(("127.0.0.1", int(port)))
    s.sendall(bytes.fromhex(token))
    wins, active, end = {}, None, time.time() + 1.0
    s.settimeout(0.1)
    buf = b""
    while time.time() < end:
        try:
            d = s.recv(65536)
        except TimeoutError:
            continue
        if not d: break
        buf += d
        while len(buf) >= 32:
            t, i, a, b, c, _, _ = struct.unpack("<6IQ", buf[:32])
            n = c if t in (109, 112) else 0
            if len(buf) < 32 + n: break
            body, buf = buf[32:32 + n], buf[32 + n:]
            if t == 109 and a: wins[i] = [x.decode("utf-8", "replace") for x in body[32:].split(b"\0")[:3]]
            elif t == 109: wins.pop(i, None)
            elif t == 110: active = i
    if not wins: die("no windows reported (this needs KDE Plasma)")
    for i, (title, cls, exe) in wins.items():
        print(f"{'*' if i == active else ' '} {title}\n    ahk_class {cls}\n    ahk_exe {exe.rsplit(chr(92), 1)[-1]}")
    print("\n* = active window")


# ---- updates ----
URL = os.environ.get("AHKB_UPDATE_URL") or "https://github.com/oleja32/ahk-linux-wine/releases"
NAME = "ahk-linux-wine"


def version():
    """(version, protocol of the installed daemon)"""
    try:
        with open(os.path.join(HOME, "VERSION")) as f:
            v, p = f.read().split()
        return v, int(p)
    except (OSError, ValueError):
        return "0", 1


def numbers(v): return [int(x) for x in re.findall(r"\d+", v)]


def fetch(path, limit=20_000_000):
    req = urllib.request.Request(f"{URL}/{path}", headers={"User-Agent": NAME})
    with urllib.request.urlopen(req, timeout=15) as r:
        if URL.startswith("https:") and not r.geturl().startswith("https:"): raise OSError("not a secure connection")
        data = r.read(limit + 1)
        if len(data) > limit: raise OSError("the file is too large")
        return r.geturl(), data


def latest():
    m = re.search(r"/tag/v(\d+(?:\.\d+)*)$", fetch("latest")[0])  # redirects to the newest release
    if not m: raise OSError("no release found")
    return m[1]


def notify(msg, *actions):
    """Shows a desktop notification; returns the name of the button that was clicked, if any."""
    cmd = ["notify-send", "-a", "AutoHotkey", "-i", "application-x-autohotkey"]
    for a in actions: cmd += ["-A", a]
    try:
        return subprocess.run([*cmd, NAME, msg], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=3600).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


class UpdateError(Exception): pass


def unpack(data, d):
    path = os.path.join(d, "a.tar.gz")
    with open(path, "wb") as f: f.write(data)
    with tarfile.open(path) as t:
        for m in t.getmembers():  # plain files and folders inside our own folder, nothing else
            parts = m.name.split("/")
            if parts[0] != NAME or ".." in parts or not (m.isfile() or m.isdir()): raise UpdateError("the download has unexpected contents")
            m.mode = 0o755 if m.isdir() or m.mode & 0o100 else 0o644
            m.uid = m.gid = os.getuid()
        t.extractall(d, **({"filter": "data"} if hasattr(tarfile, "data_filter") else {}))
    return os.path.join(d, NAME)


def install(src):
    """Runs the new version's installer; if it fails, puts everything back."""
    keep = os.path.join(HOME, "previous")
    parts = [p for p in ("bin", "v1", "v2", "inc", "detect.ahk", "VERSION") if os.path.exists(os.path.join(HOME, p))]
    shutil.rmtree(keep, ignore_errors=True)
    os.makedirs(keep)
    for p in parts:
        f, t = os.path.join(HOME, p), os.path.join(keep, p)
        shutil.copytree(f, t, symlinks=True) if os.path.isdir(f) else shutil.copy2(f, t)
    log = os.path.join(HOME, "update.log")
    with open(log, "w") as l:
        ok = subprocess.run(["./install.sh"], cwd=src, stdin=subprocess.DEVNULL, stdout=l, stderr=l).returncode == 0
    if not ok:
        bad = os.path.join(HOME, "failed")
        shutil.rmtree(bad, ignore_errors=True)
        os.makedirs(bad)
        for p in parts:  # renames: files that running scripts have open stay intact
            if os.path.lexists(os.path.join(HOME, p)): os.rename(os.path.join(HOME, p), os.path.join(bad, p))
            os.rename(os.path.join(keep, p), os.path.join(HOME, p))
        shutil.rmtree(bad, ignore_errors=True)
    shutil.rmtree(keep, ignore_errors=True)
    if not ok: raise UpdateError(f"the update could not be installed, the old version was put back (details: {log})")


def update(say, interactive):
    with open(os.path.join(HOME, "update.lock"), "w") as lock:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError: raise UpdateError("an update is already running")
        try:
            new = latest()
            if numbers(new) <= numbers(version()[0]): return say(f"You have the newest version ({version()[0]}).")
            say(f"Updating {version()[0]} to {new}...")
            data = fetch(f"download/v{new}/{NAME}.tar.gz")[1]
            want = fetch(f"download/v{new}/{NAME}.tar.gz.sha256")[1].decode().split()
        except (OSError, ValueError) as x:
            raise UpdateError(f"could not download the update ({x})")
        if not want or hashlib.sha256(data).hexdigest() != want[0]: raise UpdateError("the download is damaged (wrong checksum); nothing was changed")
        with tempfile.TemporaryDirectory() as d:
            try:
                src = unpack(data, d)
                with open(os.path.join(src, "VERSION")) as f: v, proto = f.read().split()
            except (OSError, ValueError, tarfile.TarError) as x:
                raise UpdateError(f"the download is damaged ({x}); nothing was changed")
            if v != new: raise UpdateError("the download is not the announced version; nothing was changed")
            ep = endpoint()
            if ep and ep[2] != int(proto): raise UpdateError(f"version {new} cannot be installed while scripts are running. Close them (ahk --stop), then: ahk --update")
            if subprocess.run(["./check.sh"], cwd=src, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
                if not interactive: raise UpdateError(f"version {new} needs something more on your system. Type in a terminal: ahk --update")
                if subprocess.run(["./setup.sh"], cwd=src).returncode: raise UpdateError("setup did not finish")
            else:
                install(src)
        say(f"Updated to {new}. " + ("Restart your scripts to use it." if ep else ""))


def check_update():
    """Runs in the background, at most once a day; any problem is silent."""
    try: new = latest()
    except (OSError, ValueError): return
    skip = os.path.join(HOME, "update-skip")
    if numbers(new) <= numbers(version()[0]) or (os.path.exists(skip) and open(skip).read().strip() == new): return
    c = notify(f"Version {new} is available. To install it later, type: ahk --update", "update=Update", "skip=Skip this version")
    if c == "skip":
        with open(skip, "w") as f: f.write(new)
    elif c == "update":
        try: update(lambda m: notify(m), False)
        except UpdateError as x: notify(str(x))


def maybe_check():
    stamp = os.path.join(HOME, "update-checked")
    try:
        if os.path.exists(os.path.join(HOME, "no-update-check")) or ("AHKB_HOME" in os.environ and "AHKB_UPDATE_URL" not in os.environ): return
        if os.path.exists(stamp) and 0 <= time.time() - os.path.getmtime(stamp) < 86400: return
        with open(stamp, "w"): pass
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--check-update-now"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True, cwd="/")
    except OSError:
        pass


def main():
    a, ver, default, debug = sys.argv[1:], None, "2", False
    while a and a[0].startswith("--") and a[0] != "--help":
        o = a.pop(0)
        if o in ("--v1", "--v2"): ver = o[-1]
        elif o == "--default-v1": default = "1"
        elif o == "--debug": debug = True
        elif o == "--windows":
            list_windows()
            return
        elif o == "--version":
            print(f"{NAME} {version()[0]}")
            return
        elif o == "--update":
            try: update(print, sys.stdin.isatty())
            except UpdateError as x: die(str(x))
            return
        elif o == "--prepare":  # used by install.sh
            e = wine_env()
            ensure_prefix(e)
            shrink_prefix(e["WINEPREFIX"])  # made by 0.2 or grown since
            return
        elif o == "--check-update-now":
            check_update()
            return
        elif o in ("--no-update-check", "--update-check"):
            f = os.path.join(HOME, "no-update-check")
            if o == "--no-update-check": open(f, "w").close()
            elif os.path.exists(f): os.unlink(f)
            print("ahk will " + ("not look for updates any more." if o == "--no-update-check" else "look for updates once a day."))
            return
        elif o == "--stop":
            subprocess.run(["pkill", "-u", str(os.getuid()), "-x", "ahkd"])
            if os.path.isdir(os.path.join(HOME, "prefix")):
                subprocess.run(["wineserver", "-k"], env=wine_env())
            return
        else: die(USAGE)
    if not a or a[0] in ("-h", "--help"): die(USAGE)
    script = a.pop(0)
    if not os.path.isfile(script): die(f"no such script: {script}")
    if not shutil.which("wine"): die("Wine is not installed; run ./setup.sh from the ahk-linux-wine folder")
    e = wine_env()
    ensure_prefix(e)
    ver = ver or detect(script, e, default)
    e["AHKB_PORT"], e["AHKB_TOKEN"] = ensure_daemon(debug)
    maybe_check()
    exe = os.path.join(HOME, "v1/AutoHotkeyU64.exe" if ver == "1" else "v2/AutoHotkey64.exe")
    os.execvpe("wine", ["wine", exe, win(script), *a], e)


main()
